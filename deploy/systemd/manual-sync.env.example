# Copy to /etc/locaclimb/manual-sync.env (referenced by locaclimb-manual-sync.service) and fill in.
# Skip this whole unit if server/save-api.mjs runs on this same VPS and you'd rather have
# it call scripts/enrich_manual.mjs directly after each successful save - see that file's
# header comment. This timer is the polling alternative when nothing triggers on push.
REPO_DIR=/home/locaclimb/locaclimb
GIT_REMOTE=origin
GIT_BRANCH=main
PIPELINE_CMD=npm install pngjs --no-save && node scripts/enrich_manual.mjs
COMMIT_PATHS=data/manual_enriched.json
COMMIT_MSG=data: enrich manual climbs (VPS timer)
