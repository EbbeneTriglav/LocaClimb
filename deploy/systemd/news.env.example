# Copy to /etc/locaclimb/news.env (referenced by locaclimb-news.service) and fill in.
REPO_DIR=/home/locaclimb/locaclimb
GIT_REMOTE=origin
GIT_BRANCH=main
PIPELINE_CMD=node scripts/fetch_news.mjs
COMMIT_PATHS=data/pass_news_candidates.json
COMMIT_MSG=news: aggiorna candidati GDELT (VPS timer) [skip ci]
# Optional, read directly by fetch_news.mjs (see its header comment):
# LC_NEWS_MAX=40
# LC_NEWS_SPAN=2m
# LC_NEWS_LANG=italian
