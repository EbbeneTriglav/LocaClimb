# Copy to /etc/locaclimb/osm-refresh.env (referenced by locaclimb-osm-refresh.service) and fill in.
REPO_DIR=/home/locaclimb/locaclimb
GIT_REMOTE=origin
GIT_BRANCH=main
PIPELINE_CMD=npm install pngjs --no-save && node --max-old-space-size=6144 scripts/build_osm_passes.mjs --out osm_passes.json && node scripts/bake_routes.mjs --out routes_baked.json --data passes_data.js
COMMIT_PATHS=data/osm_passes.json data/curated_overrides.json data/routes_baked.json
COMMIT_MSG=data: PBF+DEM build (VPS timer)
