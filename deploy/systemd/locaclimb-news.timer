[Unit]
Description=Run locaclimb-news every 3 days (approximates news.yml's cron "23 4 */3 * *")
# systemd OnCalendar has no direct "every N days from an arbitrary start" like cron's */3 -
# day-of-month 1,4,7,...,31 is the closest equivalent and drifts by a few days across
# month boundaries. Fine for a "no more than every ~3 days" news poll; adjust if you need
# an exact cadence.

[Timer]
OnCalendar=*-*-1/3 04:23:00
Persistent=true

[Install]
WantedBy=timers.target
