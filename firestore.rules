// LocaRide - Firestore security rules: the FULL, official copy.
// Published by hand by Rick: Firebase console -> Firestore -> Regole -> select all, paste this
// whole file, Pubblica. Edit HERE first; the console must always equal this file.
// Checked with the emulator: test/firestore-rules.emu.mjs (how to run: see that file).
// Last published: 30/10/2026 (reports added, users/{uid} self-admin hole closed).
// 01/11/2026 (to publish): ratings/votes/shared validated - any verified user could overwrite or
// delete the aggregate ratings of a climb, and votes/shared took any field of any size.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helper
    function signedIn() {
      return request.auth != null;
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return hasProfile() && profile().role == 'admin';
    }
    function canPropose() {
      return hasProfile() && profile().canPropose == true;
    }

    // ------------------------------------------- dati personali dell'utente
    // I campi 'role' e 'canPropose' decidono chi amministra e chi puo' proporre:
    // l'utente NON deve poterli toccare, altrimenti si nomina admin da solo.
    // Li imposti solo tu dalla console (la console ignora le regole).
    match /users/{uid} {
      allow read:   if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn() && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['role', 'canPropose']);

      allow update: if signedIn() && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['role', 'canPropose']);

      // sottocollezioni (routes, reviews, climbs): private, senza altre restrizioni.
      // ATTENZIONE: deve essere /{coll}/{document=**} e NON /{document=**}: in
      // rules_version 2 "{document=**}" vale anche per ZERO segmenti, cioe' per lo
      // stesso users/{uid}, e cosi' scavalcava il divieto su 'role' qui sopra
      // (chiunque poteva scriversi role: 'admin' sul proprio profilo).
      match /{coll}/{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ------------------------------------------------ valutazioni della community
    // ratings/{passo} tiene le somme, ratings/{passo}/votes/{utente} il voto: le due scritture
    // avvengono nella stessa transazione (js/reviews.js, v2/lib/diary.mjs). Prima chiunque con la
    // mail confermata poteva riscrivere o cancellare le somme di una salita. Ora le somme possono
    // cambiare SOLO di quanto cambia il voto di chi scrive (prima e dopo la transazione), e il
    // documento delle somme non si cancella.
    function myVote(passId) {
      return /databases/$(database)/documents/ratings/$(passId)/votes/$(request.auth.uid);
    }
    function was(passId, k) { return exists(myVote(passId)) ? get(myVote(passId)).data[k] : 0; }
    function now(passId, k) { return existsAfter(myVote(passId)) ? getAfter(myVote(passId)).data[k] : 0; }
    function sumsFollowMyVote(passId) {
      let old = resource == null ? { 'n': 0, 'eSum': 0, 'pSum': 0, 'tSum': 0, 'aSum': 0 } : resource.data;
      let d = request.resource.data;
      return d.keys().hasOnly(['n', 'eSum', 'pSum', 'tSum', 'aSum'])
        && d.n == old.n + (existsAfter(myVote(passId)) ? 1 : 0) - (exists(myVote(passId)) ? 1 : 0)
        && d.eSum == old.eSum + now(passId, 'e') - was(passId, 'e')
        && d.pSum == old.pSum + now(passId, 'p') - was(passId, 'p')
        && d.tSum == old.tSum + now(passId, 't') - was(passId, 't')
        && d.aSum == old.aSum + now(passId, 'a') - was(passId, 'a');
    }
    function score(v) { return v is number && v >= 1 && v <= 5; }
    function voteOk(v) {
      return v.keys().hasAll(['e', 'p', 't', 'a'])
        && v.keys().hasOnly(['e', 'p', 't', 'a', 'txt', 'by', 'ts'])
        && score(v.e) && score(v.p) && score(v.t) && score(v.a)
        && (!('txt' in v) || (v.txt is string && v.txt.size() <= 300))
        && (!('by' in v) || (v.by is string && v.by.size() <= 60))
        && (!('ts' in v) || v.ts is number);
    }
    match /ratings/{passId} {
      allow read: if true;
      allow create, update: if verified() && sumsFollowMyVote(passId);

      match /votes/{uid} {
        allow read: if true;
        allow create, update: if verified() && request.auth.uid == uid && voteOk(request.resource.data);
        allow delete: if verified() && request.auth.uid == uid;
      }
    }

    // --------------------------------------- giri condivisi via link (come prima)
    // solo i campi che l'app scrive, con tetti (e' pubblico: niente contenuti arbitrari)
    match /shared/{sid} {
      allow read: if true;
      allow create: if verified() && request.resource.data.owner == request.auth.uid
                    && request.resource.data.keys().hasOnly(['owner', 'author', 'name', 'stops', 'track', 'distKm', 'ascent', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && (!('author' in request.resource.data) || (request.resource.data.author is string && request.resource.data.author.size() <= 60))
                    && (!('stops' in request.resource.data) || (request.resource.data.stops is list && request.resource.data.stops.size() <= 40));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == resource.data.owner
                    && request.resource.data.keys().hasOnly(['owner', 'author', 'name', 'stops', 'track', 'distKm', 'ascent', 'createdAt']);
    }

    // --------------------------------------------- proposte di salite (nuovo)
    match /proposals/{pid} {

      // le approvate sono pubbliche: servono all'app per mostrarle subito e a
      // import_proposals.mjs per leggerle senza credenziali. Le altre le vedono
      // solo l'autore e l'admin.
      allow read: if resource.data.status == 'approved'
                  || (signedIn() && resource.data.uid == request.auth.uid)
                  || isAdmin();

      // solo tester abilitati, solo a proprio nome, solo in stato 'pending'
      // (nessuno puo' nascere approvato). Tetti su nome e tracciato per non
      // farsi riempire il database.
      allow create: if canPropose()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 70
                    && request.resource.data.flat is list
                    && request.resource.data.flat.size() <= 2400
                    && request.resource.data.km is number
                    && request.resource.data.km > 0
                    && request.resource.data.km < 60;

      // approvare o rifiutare: solo l'admin. L'autore puo' correggere la propria
      // proposta SOLO finche' e' in attesa, e senza poterla promuovere da solo:
      // dopo l'approvazione il contenuto e' congelato, altrimenti si potrebbe
      // cambiare cio' che e' gia' stato pubblicato.
      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.uid == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'pending'
                        && request.resource.data.uid == resource.data.uid);

      // l'autore puo' ritirare finche' e' in attesa; l'admin sempre.
      allow delete: if isAdmin()
                    || (signedIn()
                        && resource.data.uid == request.auth.uid
                        && resource.data.status == 'pending');
    }

    // ------------------------------- segnalazioni "Segnala un errore" (nuovo, v2)
    // Chi e' collegato puo' mandare una segnalazione, solo a proprio nome, solo
    // in stato 'new', con un testo di 5-1000 caratteri e solo i campi che l'app
    // scrive (niente campi estranei, niente testi giganti).
    // Leggerle, chiuderle o cancellarle: solo l'admin. Nessun altro le vede.
    match /reports/{rid} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['passId', 'passName', 'kind', 'text', 'uid', 'by', 'ts', 'status', 'app'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'new'
                    && request.resource.data.passId is string
                    && request.resource.data.passId.size() <= 120
                    && request.resource.data.passName is string
                    && request.resource.data.passName.size() <= 200
                    && request.resource.data.kind is string
                    && request.resource.data.kind.size() <= 40
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5
                    && request.resource.data.text.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }
  }
}
