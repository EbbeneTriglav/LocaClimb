// Segnalazioni dalla scheda salita (v2: "Segnala un errore"). Da INCOLLARE nelle regole esistenti
// (Firebase console -> Firestore -> Regole), dentro match /databases/{database}/documents { ... },
// accanto a users, ratings, proposals. Poi "Pubblica".
//
// Chi puo' fare cosa:
//   - creare: solo utenti autenticati, intestata a se stessi, testo 5-1000 caratteri, stato "new";
//   - leggere / chiudere: solo l'admin (users/{uid}.role == "admin");
//   - nessuno modifica o cancella le segnalazioni degli altri.
match /reports/{rid} {
  allow create: if request.auth != null
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.status == "new"
    && request.resource.data.text is string
    && request.resource.data.text.size() >= 5
    && request.resource.data.text.size() <= 1000
    && request.resource.data.passId is string;
  allow read, update, delete: if request.auth != null
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
}
