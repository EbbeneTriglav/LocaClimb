{
  // Cloudflare Workers: static assets + a tiny Worker that runs ONLY for /__/* paths.
  // The Worker reverse-proxies Firebase Auth (/__/auth/*, /__/firebase/*) so Google sign-in
  // happens on locaride.app itself (first-party): signInWithRedirect keeps working on
  // Safari/iOS and on browsers that partition third-party storage. Everything else is
  // served straight from the assets, the Worker never sees it (no cost, no latency).
  // Files NOT to publish: .assetsignore. Security/cache headers: _headers.
  "name": "locaride",
  "main": "cf/worker.js",
  "compatibility_date": "2026-09-21",
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/__/*", "/api/*"]
  }
  // Anonymous usage counts (cf/stats.js): a D1 database bound as STATS_DB, plus the secret STATS_TOKEN
  // for GET /api/stats. Until the binding below is filled in, /api/ev stores nothing (answers 204).
  // To enable: create the D1 database "locaride-stats" (dashboard: Storage & Databases -> D1), then
  // uncomment and paste its id (an id, not a secret):
  // ,"d1_databases": [{ "binding": "STATS_DB", "database_name": "locaride-stats", "database_id": "<id>" }]
}
